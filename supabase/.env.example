# Edge Function secrets only. Set with: npx supabase secrets set --env-file supabase/.env.local
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DAILY_API_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
# Base64-encoded PEM private key from your Mux signing key.
MUX_SIGNING_PRIVATE_KEY=
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by the Edge runtime.
